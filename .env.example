# ==============================================================================
# NEXUS-NER — Environment Configuration Template
# Problem Statement 26002: AI-Powered Logistics & Accessibility Platform (NER)
# ==============================================================================
# Copy this file to .env before starting the backend or building the frontend:
#   cp .env.example .env
#
# NOTE: In production environments, never commit real secrets or database passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15+ with PostGIS)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection URL:
#   postgresql://<user>:<password>@<host>:<port>/<dbname>
# Default local Docker compose mapped port is 5433:
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# In production, replace with a strong cryptographically generated random key:
#   openssl rand -hex 32
JWT_SECRET_KEY=<set-a-secure-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, specify exact allowed client domains (no wildcard with credentials).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,capacitor://localhost,ionic://localhost

# ------------------------------------------------------------------------------
# 5. WEATHER SUBSYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# Provider options:
#   open_meteo — Live weather data from Open-Meteo API (requires network connectivity)
#   mock       — Deterministic mock weather provider (for offline testing & CI)
WEATHER_PROVIDER=open_meteo

# Open-Meteo cache time-to-live in seconds (default: 900 = 15 minutes)
WEATHER_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 6. MACHINE LEARNING & PREDICTIVE RISK ENGINE
# ------------------------------------------------------------------------------
# Path to frozen Random Forest model artifact (relative to backend or absolute):
ML_MODEL_PATH=backend/app/ml/artifacts/disruption_rf_v1.joblib

# Operational ML classification threshold (balanced F1=0.887 / recall=0.902):
ML_OPERATIONAL_THRESHOLD=0.55

# Enable SHAP TreeExplainer feature attributions for risk predictions:
ML_EXPLAINABILITY_ENABLED=true

# ------------------------------------------------------------------------------
# 7. AI / NLP INCIDENT INTELLIGENCE (Phase 5)
# ------------------------------------------------------------------------------
# Provider options:
#   gemini   — Google Gemini generative AI (requires GEMINI_API_KEY)
#   fallback — Deterministic rule-based NER extraction engine (offline/test default)
NLP_PROVIDER=fallback

# Google Gemini API key (optional; system degrades safely to fallback when unset)
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# NLP extraction request timeout in seconds
NLP_REQUEST_TIMEOUT_SECONDS=12

# ------------------------------------------------------------------------------
# 8. FRONTEND CONFIGURATION (Vite Client)
# ------------------------------------------------------------------------------
# Base URL where the frontend web client and mobile app connect to the backend:
VITE_API_URL=http://127.0.0.1:8000

# Frontend Development Server Port
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 9. CLOUDINARY DURABLE PHOTO STORAGE
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
